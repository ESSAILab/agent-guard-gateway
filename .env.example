# =====================================================================
# AI 智能体安全网关 - Docker Compose 部署环境变量示例
# 复制本文件为 .env 并按需修改：cp .env.example .env
# =====================================================================

# ---- 网关服务监听配置 ----
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ---- PostgreSQL 数据库配置（docker-compose.yml 使用）----
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=please-change-this-db-password
POSTGRES_DB=guardrail

# 容器内网关连接数据库的地址（db 为 compose 中的数据库服务名）
DATABASE_URL=postgresql+psycopg2://guardrail:please-change-this-db-password@db:5432/guardrail

# ---- 安全/认证配置 ----
# 生产环境必须替换为随机长字符串
SECRET_KEY=please-change-this-secret-key-in-production
# 登录令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- 默认管理员账户（首次启动自动创建）----
# 生产环境必须修改默认弱密码 admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 可观测配置 ----
# 可观测信息级别：debug(调试) / basic(基本信息) / statistics(统计信息)
OBSERVABILITY_LEVEL=basic

# ---- 跨域配置 ----
# * 表示允许所有来源，生产环境请收敛为指定域名
CORS_ORIGINS=*
