# =====================================================================
# AI智能体安全网关 - 环境变量配置示例
# 复制本文件为 .env 并按需修改；后端启动时会自动加载 .env
# =====================================================================

# ---- 服务监听配置 ----
# 监听的主机 IP 地址，0.0.0.0 表示监听所有网卡
GATEWAY_HOST=0.0.0.0
# 服务监听端口
GATEWAY_PORT=8000

# ---- 数据库配置 ----
# 数据库连接串。
#   本地开发(SQLite):  sqlite:///./guardrail.db
#   生产(PostgreSQL):  postgresql+psycopg2://guardrail:guardrail@db:5432/guardrail
DATABASE_URL=sqlite:///./guardrail.db

# ---- 安全/认证配置 ----
# 生产环境必须替换为随机长字符串
SECRET_KEY=please-change-this-secret-key-in-production
# 登录令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- 默认管理员账户（首次启动自动创建）----
# 生产环境必须修改默认弱密码 admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 可观测配置 ----
# 可观测信息级别：debug(调试) / basic(基本信息) / statistics(统计信息)
OBSERVABILITY_LEVEL=basic

# ---- 跨域配置 ----
# * 表示允许所有来源，生产环境请收敛为指定域名
CORS_ORIGINS=*
